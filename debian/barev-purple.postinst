#!/bin/sh
set -e

CONF="/etc/yggdrasil/yggdrasil.conf"
INIT="/etc/init.d/yggdrasil"

case "$1" in
    configure)
        if [ ! -f "$INIT" ]; then
            cat > "$INIT" << 'INITEOF'
#!/sbin/openrc-run

description="An experiment in scalable routing as an encrypted IPv6 overlay network."

CONFFILE="/etc/yggdrasil/yggdrasil.conf"
pidfile="/var/run/yggdrasil/${RC_SVCNAME}.pid"

command="/usr/sbin/yggdrasil"
extra_started_commands="reload"

depend() {
  use net dns logger
}

start_pre() {
  if [ ! -f "${CONFFILE}" ]; then
    ebegin "Generating new configuration file into ${CONFFILE}"
    if ! eval ${command} -genconf > ${CONFFILE}; then
      eerror "Failed to generate configuration file"
      exit 1
    fi
  fi

  if [ ! -e /dev/net/tun ]; then
    ebegin "Inserting TUN module"
    if ! modprobe tun; then
      eerror "Failed to insert TUN kernel module"
      exit 1
    fi
  fi
}

start() {
  ebegin "Starting ${RC_SVCNAME}"
  mkdir -p /var/run/yggdrasil
  chown -R yggdrasil /var/run/yggdrasil
  start-stop-daemon --start --quiet \
    --pidfile "${pidfile}" \
    --make-pidfile \
    --background \
    --stdout /var/log/yggdrasil.stdout.log \
    --stderr /var/log/yggdrasil.stderr.log \
    --exec "${command}" -- -useconffile "${CONFFILE}"
  eend $?
}

reload() {
  ebegin "Reloading ${RC_SVCNAME}"
  start-stop-daemon --signal HUP --pidfile "${pidfile}"
  eend $?
}

stop() {
  ebegin "Stopping ${RC_SVCNAME}"
  start-stop-daemon --stop --pidfile "${pidfile}" --exec "${command}"
  eend $?
}
INITEOF
            chmod 755 "$INIT"
        fi

        if [ ! -f "$CONF" ]; then
            mkdir -p /etc/yggdrasil
            /usr/sbin/yggdrasil -genconf > "$CONF"
            chmod 600 "$CONF"

            sed -i 's/^  Peers: \[\]/  # Peers: []/' "$CONF"

            PEERS_FILE=$(mktemp)
            cat > "$PEERS_FILE" << 'PEERSEOF'
  Peers: [ "tcp://ygg.nadeko.net:44441", "tcp://ygg-us-ny.nadeko.net:44441", "tls://n.ygg.yt:443", "tls://51.15.204.214:54321", "tls://london.sabretruth.org:18472", "tls://yg-sin.magicum.net:23900", "tls://133.18.201.69:54232", "tls://yg-syd.magicum.net:23700", "tls://thinkmedia.freeddns.org:9002", "tls://yggdrasil.deavmi.assigned.network:2001", "tls://ygg-kcmo.incognet.io:8884", "tls://ygg.mnpnk.com:443" ]
PEERSEOF
            sed -i "/^  # Peers: \[\]/r $PEERS_FILE" "$CONF"
            rm -f "$PEERS_FILE"

            sed -i 's/^  IfName: .*/  IfName: barev0/' "$CONF"
        fi

        if command -v rc-update >/dev/null 2>&1; then
            rc-update add yggdrasil default 2>/dev/null || true
        fi

        if [ -x "$INIT" ]; then
            "$INIT" start || true
        fi
        ;;
esac

#DEBHELPER#
